# Copy to .env and adjust per machine:  cp .env.example .env
# All values are optional — the compose falls back to these defaults.

# Directory that holds ComfyUI model weights (diffusion_models/, text_encoders/,
# vae/, ...), mounted at /opt/ComfyUI/models. Point this at a shared model
# store to reuse downloads across projects (use a real model dir, not the
# huggingface cache dir).
#MODELS_DIR=~/VoxMin/ace-step/models

# GB of VRAM DynamicVRAM keeps free for the OS/other apps. Raise on a desktop
# with a display attached, lower for a headless box.
#VRAM_HEADROOM_GB=2

# Number of async weight-offload streams. OFF by default (0): the pinned host
# buffers compete with staged model weights on RAM-tight boxes and cause OOM
# (exit 137). Enable only on machines with plenty of RAM, e.g. 2.
#ASYNC_OFFLOAD_STREAMS=0

# Stream model weights from the mmap'd safetensors instead of pinning them in
# host RAM (--fast-disk). ON by default, and required for MiniMax H3 on a 32 GB
# RAM box: its four checkpoints total ~43 GB, so pinned staging OOM-kills the
# container (exit 137). Page-cached weights are evictable, so the kernel drops
# them under pressure instead of killing the process. Wants an NVMe model dir.
# Set to 0 only when the host can hold every checkpoint in RAM at once.
#FAST_DISK=1

# RAM budget for cached node outputs: "active inactive" GB thresholds
# (--cache-ram). Keeps decoded video frames from accumulating between runs.
#CACHE_RAM_GB=2 8

# Host swap gives the kernel somewhere to spill instead of OOM-killing. Worth
# adding on a 32 GB box even with FAST_DISK=1:
#   sudo fallocate -l 64G /swapfile && sudo chmod 600 /swapfile &&
#   sudo mkswap /swapfile && sudo swapon /swapfile
# With swap present you can also make staged weights pageable rather than
# pinned by adding --disable-pinned-memory to COMFYUI_ARGS.

# Hard caps on MiniMax H3 jobs, enforced by the wrapper API before a job is
# queued: an over-budget request gets a 400 instead of OOM-killing the server.
# Frame count is the limit that bites -- the video VAE tiles spatially but not
# temporally, so no resolution is small enough to buy back a longer clip.
# 124 frames = 5.17 s at 24 fps is the longest verified safe on 32 GB of RAM.
#MINIMAX_H3_MAX_FRAMES=124
# Secondary canvas*frames budget. 91422720 = 1152x640 at 124 frames, the
# largest combination measured to finish a 20-step job on 32 GB of RAM (the
# API's own default canvas, 864x480, sits below it with room to spare).
#MINIMAX_H3_MAX_PIXEL_FRAMES=91422720

# --- MiniMax H3 prompt rewriting (Xiaomi MiMo) ---------------------------
# The H3 endpoints take 'prompt' as a plain description and have an LLM rewrite
# it into a real H3 prompt, using MiniMax's own prompt-writing guide (vendored
# in api_wrapper/h3_prompt_skill/). Without a key, 'prompt' returns a 400 that
# points at 'raw_prompt' -- which bypasses the rewrite and needs no key at all,
# so leaving this unset only disables the rewrite, not the endpoints.
# Get a key at https://mimo.mi.com.
#MIMO_API_KEY=

# Endpoint for the rewriting model. Defaults to Xiaomi's own OpenAI-compatible
# API; point it at any chat-completions host serving the same models (DeepInfra,
# Novita, a local gateway) if you would rather not call Xiaomi directly.
#MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Default for the llm_model form field. 'auto' sends image-bearing rewrites to
# mimo-v2.5 (the omnimodal build) and text-only ones to mimo-v2.5-pro.
#MIMO_MODEL=auto

# Chain-of-thought for the rewrite: 'disabled' (default) keeps it off the
# critical path of a video request; 'enabled' trades ~10-30 s of latency for a
# more considered prompt. In thinking mode MiMo pins its own temperature.
#MIMO_THINKING=disabled
#MIMO_TEMPERATURE=0.7
#MIMO_MAX_TOKENS=4096
#MIMO_TIMEOUT=120

# Directory holding the vendored H3 prompt-writing guide (SKILL.md +
# references/). Only set this to override the copy shipped in api_wrapper/.
#H3_PROMPT_SKILL_DIR=

# Hugging Face token, required to download gated models (e.g. FLUX.2 klein 9B).
#HF_TOKEN=

# Require 'Authorization: Bearer <token>' on every HTTP route (wrapper API,
# native /prompt, /queue, /view, /ws -- which also accepts ?token= -- and the
# frontend). Unset or empty leaves the server open, as before. Use a fresh
# random value per public box, e.g. `openssl rand -hex 32`. docker-compose.yml
# passes it through; RunPod pods get theirs from voxmin-backend.
#WRAPPER_AUTH_TOKEN=

# Extra ComfyUI CLI flags appended to the server command by docker/entrypoint.sh.
# (Listen address and port come from COMFYUI_LISTEN / COMFYUI_PORT.)
#COMFYUI_ARGS=--preview-method none

# --- Docker image -------------------------------------------------------------
# Image used by docker-compose.yml. `docker compose pull` fetches it from Docker
# Hub (built by .github/workflows/docker-publish.yml); `docker compose build`
# builds this tree into the same tag. Pin a `sha-<short>` tag for reproducible
# deploys.
#COMFYUI_IMAGE=shivanshtalwar0/comfyui:latest
# Host port published for the server (the container always listens on 8188).
# The FloStudio rig publishes 8282, which voxmin-backend reaches over WireGuard.
#COMFYUI_HOST_PORT=8188
# 1 = fetch a workflow's checkpoints on first use (--auto-download-models).
#AUTO_DOWNLOAD_MODELS=1
# What `docker run ... prefetch` downloads when given no specs.
#PREFETCH_MODELS=minimaxh3:int8 minimaxh3-ref:int8 flux2klein9b
