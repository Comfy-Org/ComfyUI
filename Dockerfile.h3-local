FROM comfyui-sos-comfyui:vision-fixed

# 固定 RTX 5060 / PyTorch 2.11 cu128 的本地编译产物，不升级运行栈。
COPY sageattention-2.2.0-cp312-cp312-linux_x86_64.whl /opt/h3-wheels/
RUN echo '93ecec1aeee32f4f58f7d9b908f8b442b8dea678f9f5ab935ae3bc288d0658bb  /opt/h3-wheels/sageattention-2.2.0-cp312-cp312-linux_x86_64.whl' | sha256sum --check - \
    && python -m pip install --no-cache-dir --no-deps /opt/h3-wheels/sageattention-2.2.0-cp312-cp312-linux_x86_64.whl \
    && python -c "import importlib.metadata as m; assert m.version('torch') == '2.11.0+cu128'; assert m.version('sageattention') == '2.2.0'"

LABEL com.suzumiya.h3.sageattention.commit="d1a57a546c3d395b1ffcbeecc66d81db76f3b4b5"

# 既有 Fill 节点包的实际导入依赖；不运行其全量云端 SDK 安装。
COPY soundfile-0.14.0-py2.py3-none-manylinux_2_28_x86_64.whl /opt/h3-wheels/
RUN echo '1e38bac1853412871318e82a1ba69a8be677619b56025bbfcccdb41b6cafe82d  /opt/h3-wheels/soundfile-0.14.0-py2.py3-none-manylinux_2_28_x86_64.whl' | sha256sum --check - \
    && python -m pip install --no-cache-dir --no-deps /opt/h3-wheels/soundfile-0.14.0-py2.py3-none-manylinux_2_28_x86_64.whl \
    && python -c "import soundfile; import importlib.metadata as m; assert m.version('torch') == '2.11.0+cu128'; assert m.version('soundfile') == '0.14.0'"

COPY h3_local_requirements.txt /opt/h3-wheels/
RUN python -m pip install --no-cache-dir --no-deps --only-binary=:all: --require-hashes --index-url https://pypi.org/simple -r /opt/h3-wheels/h3_local_requirements.txt \
    && python -c "import importlib.metadata as m; assert m.version('torch') == '2.11.0+cu128'"

# 恢复原作旧分支节点，不执行会下载权重的 Impact 安装脚本。
COPY h3_legacy_requirements.txt /opt/h3-wheels/
RUN python -m pip install --no-cache-dir --no-deps --only-binary=:all: --require-hashes --index-url https://pypi.org/simple -r /opt/h3-wheels/h3_legacy_requirements.txt \
    && python -c "import piexif, dill; import importlib.metadata as m; assert m.version('torch') == '2.11.0+cu128'; assert m.version('piexif') == '1.1.3'; assert m.version('dill') == '0.4.1'"

# 只回移植官方旁路 LoRA 修复，保留0.33接口和既有量化内核。
COPY h3_fused_bypass.patch /opt/h3-wheels/
RUN echo '28a44d8c49d37534c5fb3af0855ad689c4261f5a90295034d397d84a0835f90d  /app/comfy/ops.py' | sha256sum --check - \
    && echo '618c286c5f74e823318f41774e02cfcfa02d74ee9d51320ec0aa2694cd74aa8e  /app/comfy/weight_adapter/bypass.py' | sha256sum --check - \
    && git -C /app apply --check /opt/h3-wheels/h3_fused_bypass.patch \
    && git -C /app apply /opt/h3-wheels/h3_fused_bypass.patch \
    && python -m py_compile /app/comfy/ops.py /app/comfy/weight_adapter/bypass.py \
    && python -c "import importlib.metadata as m; assert m.version('torch') == '2.11.0+cu128'"

LABEL com.suzumiya.h3.bypass.upstream="d91ed5f5b7fa60fa18464c2ad7c80254da2f0f29"
