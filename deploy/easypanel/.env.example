# Cole em Environment no Easypanel. O arquivo nao e carregado automaticamente.
COMFYUI_PORT=8188
COMFYUI_ARGS=
# Em VPS com varias GPUs, use o UUID da GPU escolhida em vez de all.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
HF_HOME=/data/cache/huggingface
TORCH_HOME=/data/cache/torch
